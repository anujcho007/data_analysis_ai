# ==========================================
# DataForge AI - Backend Environment Configuration
# ==========================================

# Secret key for HMAC token signing and security
SECRET_KEY=dataforge-ai-secret-key-super-secure-2026-auth

# Google Gemini API key for Natural Language Copilot & SQL generation (optional)
# If not provided, DataForge AI automatically operates via its built-in heuristic engine
GEMINI_API_KEY=

# Server Binding
HOST=127.0.0.1
PORT=8000

# Allowed CORS origins (comma-separated if configured via environment)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
